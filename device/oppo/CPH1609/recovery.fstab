# Recovery FSTAB for OPPO F3 (CPH1609)
# MediaTek MT6750 - Android 6.0.1 Marshmallow
# Based on stock partition layout analysis

# Device block paths
# /dev/block/platform/mtk-msdc.0/by-name/

# System partition
/dev/block/platform/mtk-msdc.0/by-name/system    /system      ext4    ro,barrier=1                                                    wait
# Cache partition
/dev/block/platform/mtk-msdc.0/by-name/cache     /cache       ext4    noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard/wait
# Data partition (userdata)
/dev/block/platform/mtk-msdc.0/by-name/userdata  /data        ext4    noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard/encryptable=footer
# Boot partition
/dev/block/platform/mtk-msdc.0/by-name/boot      /boot        emmc    defaults                                                        defaults
# Recovery partition
/dev/block/platform/mtk-msdc.0/by-name/recovery  /recovery    emmc    defaults                                                        defaults
# System info
/dev/block/platform/mtk-msdc.0/by-name/nvram     /nvram       emmc    defaults                                                        defaults
# Logo partition
/dev/block/platform/mtk-msdc.0/by-name/logo      /logo        emmc    defaults                                                        defaults
# LK (Little Kernel bootloader)
/dev/block/platform/mtk-msdc.0/by-name/lk        /lk          emmc    defaults                                                        defaults
# Preloader
/dev/block/platform/mtk-msdc.0/by-name/preloader /preloader   emmc    defaults                                                        defaults
# MBR
/dev/block/platform/mtk-msdc.0/by-name/mbr       /mbr         emmc    defaults                                                        defaults
# EBR1
/dev/block/platform/mtk-msdc.0/by-name/ebr1      /ebr1        emmc    defaults                                                        defaults
# PMT
/dev/block/platform/mtk-msdc.0/by-name/pmt       /pmt         emmc    defaults                                                        defaults
# NVRAM
/dev/block/platform/mtk-msdc.0/by-name/nvdata    /nvdata      ext4    noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard/encryptable=footer
# SECCFG
/dev/block/platform/mtk-msdc.0/by-name/seccfg    /seccfg      emmc    defaults                                                        defaults
# PROINFO
/dev/block/platform/mtk-msdc.0/by-name/proinfo   /proinfo     emmc    defaults                                                        defaults
# MISC
/dev/block/platform/mtk-msdc.0/by-name/misc      /misc        emmc    defaults                                                        defaults
# OTA
/dev/block/platform/mtk-msdc.0/by-name/ota       /ota         ext4    noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard/encryptable=footer
# MD1 (Modem)
/dev/block/platform/mtk-msdc.0/by-name/md1rom    /md1rom      emmc    defaults                                                        defaults
# MD1 DSP
/dev/block/platform/mtk-msdc.0/by-name/md1dsp    /md1dsp      emmc    defaults                                                        defaults
# MD1 ARM7
/dev/block/platform/mtk-msdc.0/by-name/md1arm7   /md1arm7     emmc    defaults                                                        defaults
# MD3
/dev/block/platform/mtk-msdc.0/by-name/md3rom    /md3rom      emmc    defaults                                                        defaults
# NVRAM BIN
/dev/block/platform/mtk-msdc.0/by-name/nvram.bin /nvram.bin   emmc    defaults                                                        defaults
# EMSC
/dev/block/platform/mtk-msdc.0/by-name/emsc      /emsc        emmc    defaults                                                        defaults
# CUST
/dev/block/platform/mtk-msdc.0/by-name/cust      /cust        emmc    defaults                                                        defaults
# USRDATA
/dev/block/platform/mtk-msdc.0/by-name/usrdata   /usrdata     emmc    defaults                                                        defaults
# FROID
/dev/block/platform/mtk-msdc.0/by-name/froid     /froid       emmc    defaults                                                        defaults
# TEMP
/dev/block/platform/mtk-msdc.0/by-name/temp      /temp        emmc    defaults                                                        defaults
# BMTPOOL
/dev/block/platform/mtk-msdc.0/by-name/bmtpool   /bmtpool     emmc    defaults                                                        defaults
# SGPT
/dev/block/platform/mtk-msdc.0/by-name/sgpt      /sgpt        emmc    defaults                                                        defaults
# PGPT
/dev/block/platform/mtk-msdc.0/by-name/pgpt      /pgpt        emmc    defaults                                                        defaults
# Android secure
/dev/block/platform/mtk-msdc.0/by-name/android_secure /android_secure vfat defaults defaults
# SD Card
/dev/block/platform/mtk-msdc.0/by-name/sdcard1   /sdcard1     vfat    defaults                                                        defaults
# FAT
/dev/block/platform/mtk-msdc.0/by-name/fat       /fat         vfat    defaults                                                        defaults
