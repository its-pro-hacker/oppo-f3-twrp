# init.recovery.mt6750.rc - OPPO F3 (CPH1609) TWRP Recovery
# MediaTek MT6750 - Android 6.0.1 Marshmallow

# TWRP Recovery initialization
on early-init
    # Set up the root directory
    mount rootfs rootfs / ro remount
    mount rootfs rootfs / rw remount

    # Mount necessary file systems
    mount tmpfs tmpfs /dev
    mount devpts devpts /dev/pts
    mount proc proc /proc
    mount sysfs sysfs /sys

    # Create device nodes
    mkdir /dev/block 0755 root root
    mkdir /dev/block/platform 0755 root root
    mkdir /dev/block/platform/mtk-msdc.0 0755 root root
    mkdir /dev/block/platform/mtk-msdc.0/by-name 0755 root root

    # Symlink for block devices
    symlink /dev/block/platform/mtk-msdc.0/by-name /dev/block/by-name

    # Mount /data partition
    mount ext4 /dev/block/platform/mtk-msdc.0/by-name/userdata /data nosuid,nodev,noatime,nodiratime,discard,errors=continue

    # Mount /cache partition
    mount ext4 /dev/block/platform/mtk-msdc.0/by-name/cache /cache nosuid,nodev,noatime,nodiratime,discard,errors=continue

    # Mount /system partition
    mount ext4 /dev/block/platform/mtk-msdc.0/by-name/system /system ro,nodev,nodiratime

    # Mount /boot partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/boot /boot nodev,noatime

    # Mount /recovery partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/recovery /recovery nodev,noatime

    # Mount /nvram partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/nvram /nvram nodev,noatime

    # Mount /logo partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/logo /logo nodev,noatime

    # Mount /lk partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/lk /lk nodev,noatime

    # Mount /preloader partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/preloader /preloader nodev,noatime

    # Mount /mbr partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/mbr /mbr nodev,noatime

    # Mount /ebr1 partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/ebr1 /ebr1 nodev,noatime

    # Mount /pmt partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/pmt /pmt nodev,noatime

    # Mount /nvdata partition
    mount ext4 /dev/block/platform/mtk-msdc.0/by-name/nvdata /nvdata nosuid,nodev,noatime,nodiratime,discard,errors=continue

    # Mount /seccfg partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/seccfg /seccfg nodev,noatime

    # Mount /proinfo partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/proinfo /proinfo nodev,noatime

    # Mount /misc partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/misc /misc nodev,noatime

    # Mount /ota partition
    mount ext4 /dev/block/platform/mtk-msdc.0/by-name/ota /ota nosuid,nodev,noatime,nodiratime,discard,errors=continue

    # Mount /md1rom partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/md1rom /md1rom nodev,noatime

    # Mount /md1dsp partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/md1dsp /md1dsp nodev,noatime

    # Mount /md1arm7 partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/md1arm7 /md1arm7 nodev,noatime

    # Mount /md3rom partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/md3rom /md3rom nodev,noatime

    # Mount /nvram.bin partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/nvram.bin /nvram.bin nodev,noatime

    # Mount /emsc partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/emsc /emsc nodev,noatime

    # Mount /cust partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/cust /cust nodev,noatime

    # Mount /usrdata partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/usrdata /usrdata nodev,noatime

    # Mount /froid partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/froid /froid nodev,noatime

    # Mount /temp partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/temp /temp nodev,noatime

    # Mount /bmtpool partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/bmtpool /bmtpool nodev,noatime

    # Mount /sgpt partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/sgpt /sgpt nodev,noatime

    # Mount /pgpt partition
    mount emmc /dev/block/platform/mtk-msdc.0/by-name/pgpt /pgpt nodev,noatime

    # Mount /android_secure partition
    mount vfat /dev/block/platform/mtk-msdc.0/by-name/android_secure /android_secure nodev,noatime

    # Mount /sdcard1 partition
    mount vfat /dev/block/platform/mtk-msdc.0/by-name/sdcard1 /sdcard1 nodev,noatime

    # Mount /fat partition
    mount vfat /dev/block/platform/mtk-msdc.0/by-name/fat /fat nodev,noatime

    # Set permissions
    chmod 0755 /dev/block/platform/mtk-msdc.0/by-name
    chmod 0755 /dev/block/platform/mtk-msdc.0/by-name/*

    # Start TWRP services
    exec u:r:recovery:s0 root root -- /system/bin/twrp

# TWRP Recovery initialization complete
on post-fs-data
    # Set up TWRP directories
    mkdir /data/media/0 0771 media_rw_data0
    mkdir /data/media/0/TWRP 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/recovery 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/boot 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/system 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/cache 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/data 0775 media_rw_data0
