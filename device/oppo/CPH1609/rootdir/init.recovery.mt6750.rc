    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/pgpt 0775 media_rw_data0

    # Set properties
    setprop tw.device.info.max_brightness 255
    setprop tw.device.info.default_brightness 128
    setprop tw.device.info.screen_timeout_secs 0
    setprop tw.device.info.has_battery_percentage true
    setprop tw.device.info.show_battery_temperature false
    setprop tw.device.info.show_battery_voltage false
    setprop tw.device.info.show_battery_current false
