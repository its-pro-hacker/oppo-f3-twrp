    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/md1dsp 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/md1arm7 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/md3rom 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/nvram.bin 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/emsc 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/cust 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/usrdata 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/froid 0775 media_rw_data0
