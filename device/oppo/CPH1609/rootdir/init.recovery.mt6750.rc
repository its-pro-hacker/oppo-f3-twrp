    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/preloader 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/mbr 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/ebr1 0775 media_rw_data0
    mkdir /data/media/0/TWRP/BACKUPS/CPH1609/pmt 0775 media_rw_data0
